include 项目文档/LICENSE 项目文档/README.md 项目文档/ORIGIN.md 项目文档/VALIDATION.md SYMBOL_MAP.json FILE_MAP.json
recursive-include src *.py *.json *.config
recursive-include checks *.py
include requirements-test.lock 项目文档/DELIVERY_VALIDATION.json
recursive-include .github *.yml
include .gitignore



include 项目文档/DEFENSIVE_SCOPE.md 项目文档/CURRENT_VALIDATION.json 项目文档/SOURCE_AUDIT.json
include checks/BOUNDARY_CHANGES.json

# Directory layout: canonical docs and source build entry; generated trees are not sdist inputs.
graft 项目文档
include 构建.py 构建配置.json
prune Build/源码
prune Build/新构建
prune Build/输出
prune Build/环境
prune Build/缓存
prune Build/中间
prune Build/临时
global-exclude __pycache__ *.py[cod] .DS_Store

# Original logical paths exist only in the staged compatibility view.
include DEFENSIVE_SCOPE.md LICENSE ORIGIN.md README.md VALIDATION.md
